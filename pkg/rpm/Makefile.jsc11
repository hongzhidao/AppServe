MODULES+=		jsc11
MODULE_SUFFIX_jsc11=	jsc11

MODULE_SUMMARY_jsc11=	Java 11 module for AppServe

MODULE_VERSION_jsc11=	$(VERSION)
MODULE_RELEASE_jsc11=	1

MODULE_CONFARGS_jsc11=	java --module=java11 --home=/usr/lib/jvm/java-11 --lib-path=/usr/lib/jvm/jre-11/lib --jars=/usr/share/appserve-jsc-common/
MODULE_MAKEARGS_jsc11=	java11
MODULE_INSTARGS_jsc11=	java11-install

MODULE_SOURCES_jsc11=	unit.example-jsc-app \
			unit.example-jsc11-config

BUILD_DEPENDS_jsc11=	java-11-openjdk-devel
BUILD_DEPENDS+=		$(BUILD_DEPENDS_jsc11)

define MODULE_DEFINITIONS_jsc11
Requires: appserve-jsc-common == $(MODULE_VERSION_jsc_common)-$(MODULE_RELEASE_jsc_common)%{?dist}.appserve
Requires: java-11-headless
endef
export MODULE_DEFINITIONS_jsc11

define MODULE_PREINSTALL_jsc11
%{__mkdir} -p %{buildroot}%{_datadir}/doc/appserve-jsc11/examples/jsc-app
%{__install} -m 644 -p %{SOURCE100} \
    %{buildroot}%{_datadir}/doc/appserve-jsc11/examples/jsc-app/index.jsp
%{__install} -m 644 -p %{SOURCE101} \
    %{buildroot}%{_datadir}/doc/appserve-jsc11/examples/appserve.config
%{__install} -m 644 -p %{bdir}/src/java/README.JSR-340 \
    %{buildroot}%{_datadir}/doc/appserve-jsc11/
endef
export MODULE_PREINSTALL_jsc11

define MODULE_POSTINSTALL_jsc11
DESTDIR=%{buildroot} make java-shared-uninstall
endef
export MODULE_POSTINSTALL_jsc11

define MODULE_FILES_jsc11
%{_libdir}/appserve/modules/*
%{_libdir}/appserve/debug-modules/*
%dir %{_datadir}/doc/appserve-jsc11
%{_datadir}/doc/appserve-jsc11/*
%{_datadir}/appserve-jsc-common/*
endef
export MODULE_FILES_jsc11

define MODULE_POST_jsc11
cat <<BANNER
----------------------------------------------------------------------

The $(MODULE_SUMMARY_jsc11) has been installed.

To check out the sample app, run these commands:

 sudo service appserve restart
 cd /usr/share/doc/%{name}/examples
 sudo curl -X PUT --data-binary @appserve.config --unix-socket /var/run/appserve/control.sock http://localhost/config
 curl http://localhost:8800/

Project repository (currently private): https://github.com/hongzhidao/AppServe

`cat /usr/share/doc/appserve-jsc11/README.JSR-340`

----------------------------------------------------------------------
BANNER
endef
export MODULE_POST_jsc11
