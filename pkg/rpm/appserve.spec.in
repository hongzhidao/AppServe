# distribution specific definitions
%define bdir %{_builddir}/%{name}-%{version}
%define dotests 0

%if 0%{?rhel}%{?fedora}
BuildRequires: gcc
%endif

%if 0%{?rhel}
%if 0%{?amzn} == 0
%define dist .el%{?rhel}
%endif
%endif

%define CC_OPT %{optflags} -fPIC
%define LD_OPT -Wl,-z,relro -Wl,-z,now -pie

%define CONFIGURE_ARGS $(echo "%%CONFIGURE_ARGS%%")

Name: appserve
Summary: AppServe
Version: %%VERSION%%
Release: %%RELEASE%%%{?dist}.appserve
License: ASL 2.0
Vendor: %%PACKAGE_VENDOR%%
URL: https://github.com/hongzhidao/AppServe
Group: System Environment/Daemons

Source0: appserve-%{version}.tar.gz
Source1: appserve.service
Source2: appserve-debug.service
Source3: unit.example.config
Source4: appserve.logrotate

BuildRoot: %{_tmppath}/%{name}-%{version}-%{release}-root-%(%{__id_u} -n)
BuildRequires: systemd
Requires(post):    systemd
Requires(preun):   systemd
Requires(postun):  systemd

BuildRequires: pcre2-devel
BuildRequires: pkgconfig

%description
AppServe is a runtime and delivery environment for modern distributed
applications. It runs the application code in multiple languages
(PHP, Python, Go, etc.), and tightly couples it with traffic delivery
in and out of the application. Take this application server
directly in the cloud / container environments and fully control your app
dynamically via an API.

%if 0%{?suse_version}
%debug_package
%endif

%if (0%{?fedora}) || (0%{?rhel} >= 8)
%define _debugsource_template %{nil}
%endif

%package devel
Summary: AppServe (development files)
Version: %%VERSION%%
Release: %%RELEASE%%%{?dist}.appserve
Group: Development/Libraries
Requires: appserve == %%VERSION%%-%%RELEASE%%%{?dist}.appserve
%description devel
Library and include files required for AppServe modules development.

%prep
%setup -q

%build
%{__make} %{?_smp_mflags} -C pkg/contrib .njs

PKG_CONFIG_PATH=%{bdir}/pkg/contrib/njs/build \
./configure \
	%{CONFIGURE_ARGS} \
	--modules=%{_libdir}/appserve/debug-modules \
	--libdir=%{_libdir} \
	--sbindir=%{_sbindir} \
	--cc-opt="%{CC_OPT}" \
	--ld-opt="%{LD_OPT}" \
	--debug
%{__make} %{?_smp_mflags}
%{__make} %{?_smp_mflags} build/libunit.a
%{__mv} build build-debug

PKG_CONFIG_PATH=%{bdir}/pkg/contrib/njs/build \
./configure \
	%{CONFIGURE_ARGS} \
	--modules=%{_libdir}/appserve/modules \
	--libdir=%{_libdir} \
	--cc-opt="%{CC_OPT}" \
	--ld-opt="%{LD_OPT}"
%{__make} %{?_smp_mflags}
%{__mv} build build-nodebug

%install
%{__rm} -rf %{buildroot}
%{__ln_s} build-nodebug build
DESTDIR=%{buildroot} make appserved-install libunit-install manpage-install
%{__install} -m755 %{bdir}/build-debug/appserved \
    %{buildroot}%{_sbindir}/appserved-debug
%{__install} -m644 %{bdir}/build-debug/libunit.a \
    %{buildroot}%{_libdir}/libunit-debug.a
%{__mkdir} -p %{buildroot}%{_libdir}/appserve/modules
%{__mkdir} -p %{buildroot}%{_libdir}/appserve/debug-modules
%{__mkdir} -p %{buildroot}%{_sharedstatedir}/appserve
%{__mkdir} -p %{buildroot}%{_localstatedir}/log/appserve
%{__mkdir} -p %{buildroot}%{_localstatedir}/run/appserve
%{__mkdir} -p %{buildroot}%{_sysconfdir}/logrotate.d
%{__install} -m 644 -p %{SOURCE4} \
    %{buildroot}%{_sysconfdir}/logrotate.d/appserve
%{__mkdir} -p %{buildroot}%{_sysconfdir}/appserve
%{__mkdir} -p %{buildroot}%{_datadir}/doc/appserve/examples
%{__install} -m 644 -p %{SOURCE3} \
    %{buildroot}%{_datadir}/doc/appserve/examples/example.config
%{__install} -m 644 -p CHANGES \
    %{buildroot}%{_datadir}/doc/appserve/
%{__install} -m 644 -p NOTICE \
    %{buildroot}%{_datadir}/doc/appserve/COPYRIGHT
%{__install} -m 644 -p README \
    %{buildroot}%{_datadir}/doc/appserve/
%{__install} -m 644 -p docs/migration.md \
    %{buildroot}%{_datadir}/doc/appserve/

%{__rm} -rf %{buildroot}%{_initrddir}/
%{__install} -p -D -m 0644 %{SOURCE1} %{buildroot}%{_unitdir}/appserve.service
%{__install} -p -D -m 0644 %{SOURCE2} %{buildroot}%{_unitdir}/appserve-debug.service
# relocate when sbindir is /usr/bin
sed -e 's:/usr/sbin:%{_sbindir}:' -i %{buildroot}%{_unitdir}/*.service


QA_SKIP_BUILD_ROOT=1
export QA_SKIP_BUILD_ROOT

%check
%if %{dotests}
cd %{bdir} && make tests && ./build/tests
%endif
%{__rm} -rf %{buildroot}/usr/src
cd %{bdir}
grep -v 'usr/src' debugfiles.list > debugfiles.list.new && mv debugfiles.list.new debugfiles.list
cat /dev/null > debugsources.list
%if 0%{?suse_version} >= 1500
cat /dev/null > debugsourcefiles.list
%endif

%clean
%{__rm} -rf %{buildroot}

%post
getent group appserve >/dev/null || groupadd -r appserve
getent passwd appserve >/dev/null || \
    useradd -r -g appserve -s /sbin/nologin \
    -d /nonexistent -c "appserve user" appserve
if [ $1 -eq 1 ]; then
    /usr/bin/systemctl preset appserve.service >/dev/null 2>&1 ||:
    /usr/bin/systemctl preset appserve-debug.service >/dev/null 2>&1 ||:
    cat <<BANNER
----------------------------------------------------------------------

Thank you for installing AppServe!

Additional modules are available in standalone packages.
To see the available modules, run "yum list available appserve-\*".

Project repository (currently private): https://github.com/hongzhidao/AppServe

----------------------------------------------------------------------
BANNER
fi

%preun
if [ $1 -eq 0 ]; then
    /usr/bin/systemctl --no-reload disable appserve.service >/dev/null 2>&1 ||:
    /usr/bin/systemctl stop appserve.service >/dev/null 2>&1 ||:
fi

%postun
/usr/bin/systemctl daemon-reload >/dev/null 2>&1 ||:
if [ $1 -ge 1 ]; then
    /usr/bin/systemctl try-restart appserve.service >/dev/null 2>&1 ||:
fi

%files
%defattr(-,root,root,-)
%attr(0755,root,root) %{_sbindir}/appserved
%attr(0755,root,root) %{_sbindir}/appserved-debug
%dir %{_sysconfdir}/appserve
%{_unitdir}/appserve.service
%{_unitdir}/appserve-debug.service
%dir %attr(0755,root,root) %ghost %{_localstatedir}/run/appserve
%dir %{_datadir}/doc/appserve
%{_datadir}/doc/appserve/*
%dir %{_libdir}/appserve/modules
%dir %{_libdir}/appserve/debug-modules
%dir %{_sharedstatedir}/appserve
%dir %attr(0755,root,root) %{_localstatedir}/log/appserve
%config(noreplace) %{_sysconfdir}/logrotate.d/%{name}
%{_mandir}/man8/appserved.8*

%files devel
%{_libdir}/libunit.a
%{_libdir}/libunit-debug.a
%{_includedir}/nxt_*.h
%{_datadir}/pkgconfig/unit.pc

%changelog
